# Local testing is honored ONLY by `next dev`, never by production builds/start.
APPLICATION_TEST_MODE=false

# Set these for Firebase Authentication and Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Prefer a local key file ignored by Git; never use a NEXT_PUBLIC_ prefix.
# Download this JSON from Firebase Project settings > Service accounts.
# The file must actually exist; this is different from the web app config above.
FIREBASE_SERVICE_ACCOUNT_PATH=.secrets/firebase-service-account.json
# Alternative: compact service account JSON in an environment variable.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Exact origin of this app (no trailing slash); localhost for development.
APP_ORIGIN=http://localhost:3000
# Comma-separated emails. Only verified users with these emails can edit the window.
RECRUITING_ADMIN_EMAILS=ajg7247@my.utexas.edu
# Optional comma-separated verified emails with read-only application access.
RECRUITING_GUEST_EMAILS=

# Optional Resend delivery for application receipts, interview emails, and referrals.
RESEND_API_KEY=
RECRUITING_FROM_EMAIL=
# Optional JSON map of exact team names to recipient email addresses.
RECRUITING_TEAM_EMAILS={}
