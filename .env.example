# Local testing is honored ONLY by `next dev`, never by production builds/start.
APPLICATION_TEST_MODE=true

# Set these for real email/password authentication and private persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exact origin of this app (no trailing slash); localhost for development.
APP_ORIGIN=http://localhost:3000
# Comma-separated emails. Only verified users with these emails can edit the window.
RECRUITING_ADMIN_EMAILS=
